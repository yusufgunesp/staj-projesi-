# Bu dosyayı `.env` olarak kopyalayıp anahtarları doldurun. `.env` git'e girmez.
# cp .env.example .env

ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Yalnızca organizasyon seviyesinde üretilmiş anahtar için: konsolda
# Settings → Workspaces → (alan) → ID. Çalışma alanına bağlı anahtarda gerekmez.
ANTHROPIC_WORKSPACE_ID=
